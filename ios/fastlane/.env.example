# Copy to ios/fastlane/.env and fill in. Never commit the filled-in version —
# .gitignore already excludes it and the .p8 key file.

# App Store Connect API key (Users and Access → Integrations)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=./fastlane/AuthKey_XXXXXXXXXX.p8

# Apple IDs
APPLE_ID=
DEVELOPER_TEAM_ID=
ITC_TEAM_ID=

# Optional: a certificates repo for `match`
# MATCH_GIT_URL=
