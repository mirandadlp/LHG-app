APP_NAME="London Hotel Group"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.londonhotelgroup.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database — MySQL 8
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lhg_property_hub
DB_USERNAME=lhg
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# API / Sanctum
# ---------------------------------------------------------------------------
# Bearer tokens issued to the iOS app expire after this many minutes.
# 43200 = 30 days. Set to null for tokens that never expire.
SANCTUM_TOKEN_EXPIRATION=43200

# Comma-separated origins allowed to call the API from a browser. The iOS app
# is not a browser and is unaffected by CORS; this is for the web client.
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Maximum size of an uploaded document, in kilobytes (20 MB).
MAX_DOCUMENT_UPLOAD_KB=20480

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@londonhotelgroup.example"
MAIL_FROM_NAME="${APP_NAME}"
